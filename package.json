{
    "name": "@particle-academy/fancy-cms-ui",
    "version": "0.14.1",
    "description": "Editor + isomorphic renderer for fancy-cms — the Stages document model, PageOp op-spine, the JS style→CSS emitter (one half of the dual-emitter pair with the PHP particle-academy/fancy-cms), and the React renderer. Built on the Fancy UI suite.",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Particle-Academy/fancy-cms-ui.git"
    },
    "homepage": "https://github.com/Particle-Academy/fancy-cms-ui#readme",
    "bugs": "https://github.com/Particle-Academy/fancy-cms-ui/issues",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        "./fonts/inter/*": "./fonts/inter-4.1/*",
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./react": {
            "import": {
                "types": "./dist/react.d.ts",
                "default": "./dist/react.js"
            },
            "require": {
                "types": "./dist/react.d.cts",
                "default": "./dist/react.cjs"
            }
        },
        "./icons": {
            "import": {
                "types": "./icons/index.d.ts",
                "default": "./icons/index.js"
            },
            "require": {
                "types": "./icons/index.d.cts",
                "default": "./icons/index.cjs"
            }
        },
        "./icons/all": {
            "import": {
                "types": "./icons/all.d.ts",
                "default": "./icons/all.js"
            },
            "require": {
                "types": "./icons/all.d.cts",
                "default": "./icons/all.cjs"
            }
        },
        "./icons/*": {
            "import": {
                "types": "./icons/glyph.d.ts",
                "default": "./icons/*.js"
            },
            "require": {
                "types": "./icons/glyph.d.cts",
                "default": "./icons/*.cjs"
            }
        },
        "./editor": {
            "import": {
                "types": "./dist/editor.d.ts",
                "default": "./dist/editor.js"
            },
            "require": {
                "types": "./dist/editor.d.cts",
                "default": "./dist/editor.cjs"
            }
        },
        "./kit": {
            "import": {
                "types": "./dist/kit.d.ts",
                "default": "./dist/kit.js"
            },
            "require": {
                "types": "./dist/kit.d.cts",
                "default": "./dist/kit.cjs"
            }
        }
    },
    "files": [
        "fonts",
        "dist",
        "icons",
        "licenses",
        "NOTICE",
        "README.md",
        "CHANGELOG.md",
        "agent-guide"
    ],
    "sideEffects": false,
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "lint": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit && eslint .",
        "test": "vitest run",
        "test:watch": "vitest",
        "parity": "node parity/run.mjs",
        "parity:wrap": "node parity/text-wrap-browser.mjs",
        "icons:generate": "node scripts/generate-icons.mjs",
        "icons:check": "node scripts/generate-icons.mjs --check",
        "icons:check:pair": "node scripts/generate-icons.mjs --check --require-twin",
        "icons:bundle": "node scripts/check-icon-bundle.mjs",
        "clean": "rm -rf dist",
        "prepublishOnly": "tsup",
        "kit:generate": "node scripts/generate-kit-catalogue.mjs",
        "kit:check": "node scripts/generate-kit-catalogue.mjs --check"
    },
    "keywords": [
        "cms",
        "website-builder",
        "wysiwyg",
        "editor",
        "fancy",
        "human-plus",
        "laravel",
        "inertia"
    ],
    "peerDependencies": {
        "@particle-academy/react-fancy": ">=3",
        "react": "^19.0.0"
    },
    "peerDependenciesMeta": {
        "@particle-academy/fancy-echarts": {
            "optional": true
        },
        "@particle-academy/react-fancy": {
            "optional": true
        }
    },
    "devDependencies": {
        "@particle-academy/classroom": "^0.7.0",
        "@particle-academy/fancy-3d": "^0.5.0",
        "@particle-academy/fancy-3d-babylon": "^0.2.0",
        "@particle-academy/fancy-3d-three": "^0.2.0",
        "@particle-academy/fancy-app-update": "^0.8.0",
        "@particle-academy/fancy-artboard": "^0.5.0",
        "@particle-academy/fancy-brand-icons": "^0.4.0",
        "@particle-academy/fancy-captcha-ui": "^0.2.1",
        "@particle-academy/fancy-code": "^0.16.0",
        "@particle-academy/fancy-diff": "^0.5.1",
        "@particle-academy/fancy-docs": "^0.4.0",
        "@particle-academy/fancy-file-commons": "^0.5.0",
        "@particle-academy/fancy-flow": "^0.84.0",
        "@particle-academy/fancy-fun-lab-ui": "^0.1.0",
        "@particle-academy/fancy-git": "^0.3.3",
        "@particle-academy/fancy-git-ui": "^0.5.0",
        "@particle-academy/fancy-grid": "^0.4.1",
        "@particle-academy/fancy-mlm-ui": "^0.4.0",
        "@particle-academy/fancy-motion": "^0.2.0",
        "@particle-academy/fancy-passkeys-ui": "^0.2.1",
        "@particle-academy/fancy-sheets": "^0.13.1",
        "@particle-academy/fancy-slides": "^0.25.1",
        "@particle-academy/fancy-term": "^0.8.1",
        "@particle-academy/fancy-trading": "^0.2.1",
        "@particle-academy/fancy-trading-ui": "^0.1.0",
        "@particle-academy/fancy-walkthrough": "^0.4.1",
        "@particle-academy/fancy-whats-new": "^0.1.1",
        "@particle-academy/fancy-whiteboard": "^0.5.1",
        "@particle-academy/fancy-x-files-ui": "^0.2.0",
        "@particle-academy/job-board": "^0.5.0",
        "@particle-academy/last-word-ui": "^0.5.0",
        "@particle-academy/react-fancy": "^6.24.1",
        "@particle-academy/teachers-aid-ui": "^0.3.0",
        "@types/node": "^22",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "eslint": "^10.8.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "jsdom": "^29.1.1",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "tsup": "^8.5.0",
        "typescript": "^5.8.0",
        "typescript-eslint": "^8.65.0",
        "vitest": "^4.1.12"
    },
    "engines": {
        "node": ">=22"
    },
    "publishConfig": {
        "access": "public"
    },
    "license": "MIT",
    "overrides": {
        "esbuild": "^0.28.1",
        "source-map-js": "^1.2.2"
    },
    "dependencies": {
        "@particle-academy/fancy-doc-commons": ">=0.4 <2.0"
    }
}
